{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:tenant:1",
  "title": "Tenant",
  "description": "spec of the Tenant manifest: the kind, the limits, the time zone, privacy, channel commands, /run, default_types and the blocks of farm parts (docs/task-language.md, \"Tenant fields\").",
  "x-botaru-direction": "input",
  "x-botaru-rules": [
    "MAN-1",
    "APR-9",
    "CAP-1",
    "TIM-2",
    "BUD-1",
    "SEC-8",
    "PRM-16",
    "IDN-6",
    "APR-17",
    "DSP-10"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "test",
        "production"
      ],
      "description": "Tenant kind; production without the field (APR-9)."
    },
    "self_approve": {
      "type": "boolean",
      "description": "Whether one's own request can be approved; true on a production tenant does not pass apply (APR-9)."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_queued": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "description": "Ceiling of tasks in the tenant's queue (CAP-1)."
        },
        "max_enqueue_per_hour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "description": "Ceiling of enqueues per hour (CAP-1)."
        },
        "max_storage_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000,
          "description": "Ceiling of the space of the tenant's files and artifacts in bytes (CAP-1)."
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000000,
          "description": "From v0.2: the limit of one file (ART-4).",
          "x-botaru-version": "v0.2"
        },
        "max_task_files_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000000,
          "description": "From v0.2: the limit of all files of one task (ART-4).",
          "x-botaru-version": "v0.2"
        }
      },
      "description": "Tenant limits; exceeding them gives over_capacity (CAP-1)."
    },
    "timezone": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tz",
      "description": "Time zone of schedules and budget windows (TIM-2)."
    },
    "models_allowed": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/name"
      },
      "description": "Allowed model profiles (GW-7).",
      "uniqueItems": true
    },
    "providers_allowed": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/name"
      },
      "description": "Allowed providers (SEC-8).",
      "uniqueItems": true
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "month_eur": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Monthly limit of the tenant in euros (BUD-1)."
        },
        "day_eur": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Daily limit; month_eur/20 by default."
        },
        "hour_eur": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Hourly limit; month_eur/100 by default, exceeding it gives the runaway_spend hold for an hour (HLD-7)."
        },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "work": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "per_role_month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "Budget line: a sublimit inside the total, 0 by default."
            },
            "insight": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "per_role_month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "Budget line: a sublimit inside the total, 0 by default."
            },
            "aggregate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "per_role_month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "Budget line: a sublimit inside the total, 0 by default."
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "per_role_month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "Budget line: a sublimit inside the total, 0 by default."
            },
            "governance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "per_role_month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "Budget line: a sublimit inside the total, 0 by default."
            },
            "manager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "per_role_month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "Budget line: a sublimit inside the total, 0 by default."
            },
            "grant": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "From v0.2: model grants of the tenant executors (MGR-17, MGR-18); 0 by default, then there is no request_model_grant.",
              "x-botaru-version": "v0.2"
            },
            "takeover": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                },
                "day_eur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Amount in euros."
                }
              },
              "description": "From v0.2: takeover tasks on the seat profile (MGR-21); 0 by default, then there is no takeover.",
              "x-botaru-version": "v0.2"
            }
          },
          "description": "Budget lines by type purposes (BUD-7)."
        },
        "tasks_in_flight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "From v0.2: direct requests of one human or service principal with a running attempt at the same time; 3 by default. A further request waits with in_flight_cap (BUD-6).",
          "x-botaru-version": "v0.2"
        }
      },
      "required": [
        "month_eur"
      ],
      "description": "Spending limits of the tenant (BUD-1)."
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purposes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "type": "string",
                "maxLength": 40,
                "description": "Purpose from spec/model/processing-purposes.yaml.",
                "pattern": "^[a-z][a-z0-9_]*$",
                "x-botaru-registry": "processing-purposes"
              },
              "lawful_basis": {
                "enum": [
                  "public_task",
                  "legitimate_interest",
                  "contract",
                  "consent",
                  "legal_obligation"
                ],
                "description": "Lawful basis; public_task by default, consent only with a consent record."
              }
            },
            "required": [
              "purpose"
            ]
          },
          "description": "Processing purposes (SEC-8)."
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200,
              "description": "Controller name."
            },
            "contact": {
              "type": "string",
              "maxLength": 200,
              "description": "Controller contact."
            },
            "agreement_ref": {
              "type": "string",
              "maxLength": 200,
              "description": "Link to the data processing agreement."
            }
          }
        },
        "subprocessors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name",
                "description": "Name of the provider binding."
              },
              "agreement_ref": {
                "type": "string",
                "maxLength": 200,
                "description": "Link to the agreement."
              },
              "region": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name",
                "description": "Region from the list of the provider binding."
              },
              "retention": {
                "description": "Retention at the provider (GW-15).",
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "const": "standard"
                      },
                      "max_days": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3650,
                        "description": "Longest retention period at the provider."
                      }
                    },
                    "required": [
                      "mode",
                      "max_days"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "const": "zero"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  }
                ]
              },
              "terms": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "training": {
                    "const": false,
                    "description": "The provider does not train models on requests."
                  },
                  "human_review": {
                    "enum": [
                      "none",
                      "abuse_only"
                    ],
                    "description": "Allowed review of requests by the provider's people."
                  }
                },
                "description": "Agreement terms (GW-15)."
              }
            },
            "required": [
              "provider"
            ]
          },
          "description": "Subprocessors (SEC-8, GW-14, GW-15)."
        },
        "channels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "driver": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name",
                "description": "Channel driver."
              },
              "third_party_storage": {
                "type": "boolean",
                "description": "Whether a third party stores the conversation."
              },
              "ceiling": {
                "$ref": "urn:botaru:schema:common:1#/$defs/data_mark",
                "description": "Ceiling of the channel's data class (SEC-9)."
              }
            },
            "required": [
              "driver"
            ]
          },
          "description": "Channels and their ceilings."
        },
        "recipients": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "enum": [
              "model_provider",
              "messenger",
              "monitoring"
            ]
          },
          "description": "Data recipients; monitoring is mandatory only when the installation claims the monitor profile (MON-1, D-88).",
          "uniqueItems": true
        },
        "notice_ref": {
          "type": "string",
          "maxLength": 300,
          "description": "Link to the full text of the privacy notice."
        },
        "notice_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Notice version for the privacy_notice delivery (SEC-13)."
        },
        "dpia_ref": {
          "type": "string",
          "maxLength": 200,
          "description": "Link to the impact assessment, or an explicit none."
        },
        "ropa_ref": {
          "type": "string",
          "maxLength": 200,
          "description": "Link to the record of processing activities."
        },
        "subject_request_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "Deadline for answering a person's request, 30 days by default."
        },
        "export_sink": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name",
          "description": "From v0.2: the sink of a confirmed /mydata export; it must be an export_only sink (SEC-10, LCY-2).",
          "x-botaru-version": "v0.2"
        }
      },
      "description": "Privacy block of the tenant (SEC-8); the fields are described in docs/privacy.md."
    },
    "model_transfer": {
      "type": "array",
      "maxItems": 20,
      "description": "Basis for transferring data to a model provider with a region outside the EU, separate for every controller tenant (GW-14, D-87 (2)). An entry covers a provider (all its regions or one region) or a region without a provider. A production tenant (kind: production) that has in privacy.subprocessors the provider of a profile from models_allowed with a region outside the EU (the list is in the note of the provider binding) passes apply only if such an entry exists (code transfer_basis_missing).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "$ref": "urn:botaru:schema:common:1#/$defs/name",
            "description": "Provider from privacy.subprocessors."
          },
          "region": {
            "$ref": "urn:botaru:schema:common:1#/$defs/name",
            "description": "Region from the list of the provider binding; without the field the entry covers all regions of the provider."
          },
          "basis": {
            "enum": [
              "scc",
              "adequacy",
              "consent"
            ],
            "description": "Basis: standard contractual clauses (scc), an adequacy decision (adequacy) or the consent of the tenant's people (consent)."
          },
          "checked": {
            "$ref": "urn:botaru:schema:manifest:1#/$defs/date",
            "description": "Date of the basis check."
          }
        },
        "required": [
          "basis",
          "checked"
        ],
        "anyOf": [
          {
            "required": [
              "provider"
            ]
          },
          {
            "required": [
              "region"
            ]
          }
        ]
      }
    },
    "delegated_groups": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/name"
      },
      "description": "Groups that the tenant admin grants without the operator (PRM-16).",
      "uniqueItems": true
    },
    "operator_access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debug_journal": {
          "enum": [
            "deny",
            "notify",
            "allow"
          ],
          "description": "Operator reading of attempt journals and task replays (AUD-4, APR-8); notify by default."
        }
      }
    },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wake_day_eur": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Daily ceiling of wake-ups by inbox; day_eur/10 by default (MSG-11)."
        },
        "wakes_per_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Wake-ups per day per tenant; 200 by default."
        }
      }
    },
    "link_allowlist": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:botaru:schema:manifest:1#/$defs/hostname"
      },
      "description": "Link domains that stay in outbound (INJ-11).",
      "uniqueItems": true
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fairness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interactive": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight."
                },
                "campaign": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight."
                },
                "root": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight."
                },
                "route": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight."
                },
                "schedule": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight."
                },
                "script": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight."
                },
                "system": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Fairness key weight of tasks that the core creates itself (system:<purpose>, DSP-2)."
                }
              }
            }
          },
          "x-botaru-version": "v0.2"
        },
        "background_share": {
          "type": "string",
          "maxLength": 4,
          "pattern": "^[1-9][0-9]?%$|^100%$",
          "description": "From v0.2: the share of a bot group's capacity that class 5 tasks of the purposes insight, aggregate and review hold together, 20% by default (BUD-8).",
          "x-botaru-version": "v0.2"
        },
        "rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "$ref": "urn:botaru:schema:common:1#/$defs/type_name"
                  },
                  "type_prefix": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "Type name prefix with a dot at the end.",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*\\.$"
                  },
                  "source": {
                    "enum": [
                      "interactive",
                      "campaign",
                      "root",
                      "route",
                      "schedule",
                      "script",
                      "system"
                    ],
                    "description": "Kind of the task source; system for tasks that the core creates itself (DSP-2)."
                  }
                },
                "description": "Matching only by the type name or name prefix and the source kind (DSP-3)."
              },
              "group": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name",
                "description": "Default bot group."
              },
              "group_fixed": {
                "type": "boolean",
                "description": "A request cannot set another group."
              },
              "priority_class": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Priority class; a rule can only lower it."
              },
              "max_running": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000,
                "description": "At most this many tasks of the type at the same time in the tenant."
              },
              "max_share": {
                "type": "string",
                "maxLength": 4,
                "description": "From v0.2: the share of the capacity of the rule's group that the tasks of this rule hold, for example 20%, rounded down but at least one; the rule needs group (DSP-11, lint max_share_without_group).",
                "pattern": "^[1-9][0-9]?%$|^100%$",
                "x-botaru-version": "v0.2"
              },
              "timeouts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attempt": {
                    "$ref": "urn:botaru:schema:common:1#/$defs/duration"
                  }
                },
                "description": "Attempt deadline: at most two deadlines of the type and no later than deadline."
              },
              "retry": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3,
                    "description": "Only less than for the type, and at least 1."
                  }
                }
              }
            },
            "required": [
              "match"
            ],
            "description": "Dispatcher rule; only narrows the hand-out (DSP-3)."
          },
          "description": "Rules in order: the first match."
        },
        "unclaimed_alarm_after": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration",
          "description": "When a task that nobody took gives an alarm; the type's start_by by default."
        }
      },
      "description": "Dispatcher rules of the tenant (DSP-3)."
    },
    "commands": {
      "type": "object",
      "maxProperties": 50,
      "description": "Channel command -> the full type name with .vN; built-in commands cannot be taken (PRM-17).",
      "propertyNames": {
        "pattern": "^/[a-z][a-z0-9_-]{0,30}$"
      },
      "additionalProperties": {
        "$ref": "urn:botaru:schema:common:1#/$defs/type_name"
      }
    },
    "script_commands": {
      "type": "object",
      "maxProperties": 20,
      "x-botaru-version": "v0.2",
      "description": "From v0.2: channel command -> the name of a kind: Script manifest of the tenant; the command starts the script with key=value parameters through the script_confirm card (SCR-14). Built-in commands and commands of commands cannot be taken (PRM-17).",
      "propertyNames": {
        "pattern": "^/[a-z][a-z0-9_-]{0,30}$"
      },
      "additionalProperties": {
        "$ref": "urn:botaru:schema:common:1#/$defs/name"
      }
    },
    "run": {
      "type": "object",
      "maxProperties": 50,
      "description": "Pipelines of the command /run <name>: exactly one of {type, args} or {action, args} (APR-17).",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "$ref": "urn:botaru:schema:common:1#/$defs/type_name"
              },
              "args": {
                "type": "array",
