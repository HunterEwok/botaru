{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:commission:1",
  "title": "Tenant commission",
  "description": "spec of the Commission manifest: only thresholds and weights by lens (COM-8); the seats and lenses are set by the charter and the skeleton.",
  "x-botaru-direction": "input",
  "x-botaru-rules": [
    "COM-8",
    "COM-10",
    "GOV-34"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review_deadline": {
      "$ref": "urn:botaru:schema:common:1#/$defs/duration"
    },
    "min": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 4
      },
      "description": "Lens minimums; only raised relative to the skeleton."
    },
    "weights": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 3
      },
      "description": "Lens weights, integers 1-3."
    },
    "recommend_if": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weighted_mean_gte": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Threshold."
        },
        "value_gte": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Threshold."
        }
      }
    },
    "park_if": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weighted_mean_gte": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Threshold."
        }
      }
    },
    "high_risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "security_gte": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Threshold."
        },
        "operational_gte": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Threshold."
        }
      }
    },
    "untrusted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value_gte": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Threshold."
        },
        "risk_max": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "shadow": {
      "description": "Shadow shares (COM-10, GOV-34); 0 is allowed only with an explicit off.",
      "anyOf": [
        {
          "const": "off"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "veto_lenses": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share for lenses with a veto."
            },
            "other_lenses": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share for the others."
            }
          }
        }
      ]
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forward_if_score_gte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Only raised."
        },
        "untrusted_forward_if_score_gte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Only raised."
        }
      },
      "description": "From v0.2: the necessity lens (COM-13).",
      "x-botaru-version": "v0.2"
    }
  }
}
