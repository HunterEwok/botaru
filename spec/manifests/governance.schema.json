{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:governance:1",
  "title": "Charter",
  "description": "spec of the Governance manifest: the tenant charter (commission seats, positions, path deadlines, memory limits) or the farm charter farm (the farm manager seat). Every numeric field changes only in one direction from the default (GOV-33).",
  "x-botaru-direction": "input",
  "x-botaru-rules": [
    "GOV-33",
    "GOV-3",
    "GOV-4",
    "GOV-14",
    "MGR-14"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "positions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functional": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the profile ceiling."
            },
            "analysis_max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the ceiling."
            },
            "persona": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Path of the persona file personas/<name>.md.",
                  "pattern": "^personas/[a-z][a-z0-9-]*\\.md$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Hash of the persona file.",
                  "pattern": "^([0-9a-f]{64}|\\.\\.\\.)$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "description": "Persona by hash (GOV-4)."
            },
            "addenda": {
              "type": "object",
              "additionalProperties": false,
              "description": "From v0.3: addenda to the persona per role profile, pinned by hash (GOV-45).",
              "properties": {
                "reporter": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ref": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Path of the persona file personas/<name>.md.",
                      "pattern": "^personas/[a-z][a-z0-9-]*\\.md$"
                    },
                    "sha256": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "Hash of the persona file.",
                      "pattern": "^([0-9a-f]{64}|\\.\\.\\.)$"
                    }
                  },
                  "required": [
                    "ref",
                    "sha256"
                  ],
                  "description": "Addendum by hash, appended after the persona for bots of the profile (GOV-45)."
                }
              }
            }
          }
        },
        "assistant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the profile ceiling."
            },
            "analysis_max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the ceiling."
            },
            "persona": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Path of the persona file personas/<name>.md.",
                  "pattern": "^personas/[a-z][a-z0-9-]*\\.md$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Hash of the persona file.",
                  "pattern": "^([0-9a-f]{64}|\\.\\.\\.)$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "description": "Persona by hash (GOV-4)."
            }
          }
        },
        "translator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the profile ceiling."
            },
            "analysis_max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the ceiling."
            },
            "persona": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Path of the persona file personas/<name>.md.",
                  "pattern": "^personas/[a-z][a-z0-9-]*\\.md$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Hash of the persona file.",
                  "pattern": "^([0-9a-f]{64}|\\.\\.\\.)$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "description": "Persona by hash (GOV-4)."
            }
          }
        },
        "commission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the profile ceiling."
            },
            "analysis_max_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Only lowers the ceiling."
            },
            "persona": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Path of the persona file personas/<name>.md.",
                  "pattern": "^personas/[a-z][a-z0-9-]*\\.md$"
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Hash of the persona file.",
                  "pattern": "^([0-9a-f]{64}|\\.\\.\\.)$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "description": "Persona by hash (GOV-4)."
            }
          }
        }
      },
      "description": "Positions and their personas (GOV-4)."
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seat_role": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name",
          "description": "Role of the reviewer profile."
        },
        "model_profile": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name",
          "description": "Profile of the seat slot."
        },
        "seats": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "description": "Seat number."
              },
              "lens": {
                "type": "string",
                "maxLength": 40,
                "description": "Lens from lenses.yaml.",
                "pattern": "^[a-z][a-z_]*$"
              },
              "fallback_role": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name"
              },
              "model_profile": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name"
              },
              "reward_profile": {
                "$ref": "urn:botaru:schema:common:1#/$defs/name",
                "description": "From v0.3: the model profile of reviews of hard proposals for the most accurate holder; rank no higher than the seat role's profile ceiling (COM-18, GOV-3)."
              }
            },
            "required": [
              "id",
              "lens"
            ]
          }
        },
        "audit_sample": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_per_month": {
              "type": "integer",
              "minimum": 4,
              "maximum": 1000,
              "description": "At least 4 (DIG-5)."
            },
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share."
            },
            "max_per_digest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Items in the digest."
            }
          }
        },
        "accountability": {
          "enum": [
            "shadow",
            "on"
          ],
          "default": "shadow",
          "description": "From v0.3: shadow (code computes and shows to people only) or on; apply accepts on only while every seat has a holder with at least 20 scored forecasts, otherwise accountability_not_ready (GOV-36)."
        },
        "reward_cap_eur_month": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 0,
          "description": "From v0.3: money a month from the review line for the reward of the most accurate member; 0 means no reward (COM-18)."
        }
      },
      "description": "Commission seats (GOV-33)."
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probation": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        },
        "exclude_change_kinds": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40,
            "description": "Change kind.",
            "pattern": "^[a-z_]+$"
          }
        },
        "min_tenure": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        },
        "swap_cooldown": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        }
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protect_new": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        }
      }
    },
    "ballots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reissue_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Only raised."
        },
        "stuck_after": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unbound_ttl": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seal_ttl": {
          "$ref": "urn:botaru:schema:common:1#/$defs/duration"
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Only reduce."
            },
            "per_attempt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "Only reduce."
            }
          }
        },
        "offer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Only reduce."
            },
            "take_max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50,
              "description": "Only reduce."
            }
          }
        }
      }
    },
    "farm_manager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Rank ceiling of the seat."
        },
        "model_profile": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name"
        },
        "persona": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 200,
              "description": "Path of the persona file personas/<name>.md.",
              "pattern": "^personas/[a-z][a-z0-9-]*\\.md$"
            },
            "sha256": {
              "type": "string",
              "maxLength": 64,
              "description": "Hash of the persona file.",
              "pattern": "^([0-9a-f]{64}|\\.\\.\\.)$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "description": "Persona by hash (GOV-4)."
        },
        "incident_stop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decide_within": {
              "$ref": "urn:botaru:schema:common:1#/$defs/duration",
              "description": "At most 7d."
            }
          },
          "description": "v0.1 and v0.2 only; a v0.3 core warns with incident_stop_unused (MGR-55)."
        },
        "control_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ops_per_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "Limit per hour."
            },
            "quarantines_per_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Limit per hour."
            },
            "cancels_per_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "Limit per hour."
            },
            "pins_per_worker_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Limit per hour."
            },
            "max_share_held": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share of a role under holds."
            },
            "hold_ttl_max": {
              "$ref": "urn:botaru:schema:common:1#/$defs/duration"
            },
            "daily_review_max_eur": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Amount in euros."
            }
          },
          "description": "Seat limits (MGR-14, MGR-41)."
        },
        "grant_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seat_grants_eur_day": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Amount in euros."
            },
            "decide_debounce": {
              "$ref": "urn:botaru:schema:common:1#/$defs/duration"
            },
            "grant_wait_max": {
              "$ref": "urn:botaru:schema:common:1#/$defs/duration"
            },
            "requests_per_role_day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Grant requests per role per day (MGR-17)."
            },
            "eval_fail_share_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The sign \"type history\": the lowest failure share of a grant_eval_set run on the base model; 0.3 by default (MGR-17)."
            }
          },
          "x-botaru-version": "v0.2"
        },
        "breaker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consecutive_denials": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Refusals in a row before the safeguard."
            }
          }
        },
        "fallback_profile": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name",
          "description": "From v0.3: the profile for work outside sev1 when a tenant's monthly manager line is spent; needs an mgr-inj report with zero security failures (MGR-49)."
        },
        "postmortem": {
          "type": "boolean",
          "default": true,
          "description": "From v0.3: the analysis after an incident (MGR-53)."
        },
        "postmortem_max_eur": {
          "type": "object",
          "additionalProperties": false,
          "description": "From v0.3: the analysis ceiling per incident and per day, from the manager line outside the sev1 reserve (MGR-53, MGR-56).",
          "properties": {
            "incident": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "day": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      },
      "description": "The farm manager seat; only in the charter of the tenant farm."
    }
  }
}
