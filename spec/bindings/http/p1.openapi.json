  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The worker token, or the handle named by the operation."
      }
    },
    "parameters": {
      "BotaruLease": {
        "name": "Botaru-Lease",
        "in": "header",
        "required": true,
        "description": "The holder's current lease token.",
        "schema": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "BotaruLeaseOptional": {
        "name": "Botaru-Lease",
        "in": "header",
        "required": false,
        "description": "The holder's current lease token; sent by callers under a lease, absent for the callers the map row names without one.",
        "schema": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "BotaruOnBehalf": {
        "name": "Botaru-On-Behalf",
        "in": "header",
        "required": true,
        "description": "Identity of the person verified by the channel.",
        "schema": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "BotaruChat": {
        "name": "Botaru-Chat",
        "in": "header",
        "required": true,
        "description": "The chat of the press or command: direct:<id> or group:<id>.",
        "schema": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "BotaruMessage": {
        "name": "Botaru-Message",
        "in": "header",
        "required": false,
        "description": "The channel message of a card button press; required for a button press, absent for a typed command.",
        "schema": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "traceparent": {
        "name": "traceparent",
        "in": "header",
        "required": false,
        "description": "W3C trace context; decides nothing (OBS-3).",
        "schema": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "A refusal: problem details (RFC 9457) with a reason from spec/model/reasons.yaml.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../../model/common.schema.json#/$defs/problem"
            }
          }
        }
      }
    }
  }
