{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p2-erasure-list-response:1",
  "title": "P2 erasure.list: response",
  "description": "Erasure requests with the outcome for each store (RET-7).",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "RET-7"
  ],
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "urn:botaru:schema:deletion-request:1"
      },
      "maxItems": 1000
    },
    "next": {
      "type": "string",
      "maxLength": 200,
      "description": "Cursor of the next page from the previous answer."
    }
  }
}
