{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p2-task-request:1",
  "title": "P2 task.show and task.cancel: request",
  "description": "Show or cancel a task; cancellation with children, outcome canceled(initiator) (APR-6). A denial names the needed group or permission in needs.",
  "x-botaru-direction": "input",
  "x-botaru-rules": [
    "PRM-9",
    "PRM-15",
    "APR-6"
  ],
  "type": "object",
  "required": [
    "op",
    "task"
  ],
  "properties": {
    "op": {
      "enum": [
        "task.show",
        "task.cancel"
      ]
    },
    "task": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
    }
  },
  "additionalProperties": false
}
