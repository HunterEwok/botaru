{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:monitor-note:1",
  "title": "Problem note",
  "description": "The monitor_note delivery: a note on a problem on a node of one's own tenant with the mark [botaru <bot_id>]. Since v0.1 only a code note from the template service_control_done with closed fields (MON-8); a bot note text of up to 1000 characters since v0.2 (MON-7).",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "MON-8"
  ],
  "type": "object",
  "required": [
    "eventid",
    "bot_id"
  ],
  "properties": {
    "eventid": {
      "description": "Problem id.",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{1,20}$"
    },
    "bot_id": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Bot id."
    },
    "template": {
      "description": "Template of the code note.",
      "const": "service_control_done"
    },
    "fields": {
      "type": "object",
      "description": "Closed fields of the template service_control_done.",
      "additionalProperties": false,
      "required": [
        "verb",
        "result"
      ],
      "properties": {
        "service": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name",
          "description": "Catalog service."
        },
        "script": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name",
          "description": "Script from monitor_scripts_allowed."
        },
        "verb": {
          "description": "Verb.",
          "enum": [
            "start",
            "stop",
            "restart",
            "run"
          ]
        },
        "result": {
          "description": "Outcome.",
          "enum": [
            "success",
            "failed"
          ]
        },
        "grant_id": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
          "description": "The service_grant grant."
        },
        "approval_id": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
          "description": "Approval."
        }
      }
    },
    "text": {
      "description": "Text of the bot note up to 1000 characters (v0.2).",
      "type": "string",
      "maxLength": 1000,
      "x-botaru-version": "v0.2"
    }
  },
  "oneOf": [
    {
      "required": [
        "template",
        "fields"
      ],
      "not": {
        "required": [
          "text"
        ]
      }
    },
    {
      "required": [
        "text"
      ],
      "not": {
        "required": [
          "template"
        ]
      }
    }
  ]
}
