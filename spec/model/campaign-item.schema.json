{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:campaign-item:1",
  "title": "Campaign item",
  "description": "Item record (CampaignItem): campaign, number, resource, state, item task, reason and the closed outcome fields from the type's summary_fields (ORC-9). Only the core writes it; the item task gets the key system:campaign:<campaign>:<n> (ORC-3).",
  "x-botaru-direction": "record",
  "x-botaru-retention": "metadata",
  "x-botaru-rules": [
    "ORC-3",
    "ORC-4",
    "ORC-9"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign",
    "n",
    "resource",
    "state"
  ],
  "properties": {
    "campaign": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "resource": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name"
    },
    "state": {
      "enum": [
        "pending",
        "released",
        "ok",
        "failed",
        "unknown",
        "skipped",
        "canceled"
      ]
    },
    "task": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
    },
    "reason": {
      "$ref": "urn:botaru:schema:common:1#/$defs/reason"
    },
    "fields": {
      "type": "object",
      "description": "Closed outcome fields from the type's summary_fields; only leaves of closed kinds (INJ-1).",
      "maxProperties": 16
    }
  }
}
