{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:proposal-record:1",
  "title": "Proposal record",
  "description": "Only the core writes a proposal record (PRP-1, IDN-1); a bot hands in only the proposal-body. Closed fields and decisions belong to the storage class metadata; the author note body.note and free-form human feedback belong to the class content. The state changes only by spec/lifecycles/proposal.md (PRP-6).",
  "x-botaru-direction": "record",
  "x-botaru-retention": "metadata",
  "x-botaru-rules": [
    "PRP-1",
    "PRP-5",
    "PRP-6",
    "PRP-7",
    "PRP-9",
    "PRP-14",
    "PRP-22",
    "PRP-18",
    "PRP-19",
    "PRP-20",
    "INS-3"
  ],
  "type": "object",
  "required": [
    "id",
    "tenant",
    "origin",
    "fingerprint",
    "data_mark",
    "untrusted_seen",
    "self_influence",
    "conflicts_with",
    "seen_count",
    "state",
    "body",
    "reviews",
    "verdict",
    "decision",
    "realization",
    "trial"
  ],
  "properties": {
    "id": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
    },
    "tenant": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name"
    },
    "origin": {
      "type": "object",
      "required": [
        "role",
        "worker",
        "acting_bot",
        "task",
        "level"
      ],
      "properties": {
        "role": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name"
        },
        "worker": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
        },
        "acting_bot": {
          "anyOf": [
            {
              "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
              "description": "The author bot from the attempt that handed in the result; empty for a worker without a numbered bot (PRP-14)."
            },
            {
              "type": "null"
            }
          ]
        },
        "bot_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
        },
        "level": {
          "enum": [
            0,
            1,
            2
          ],
          "description": "Author level: 0 a seat bot, 1 an aggregator; 2 the farm manager from the daily review (since v0.2, MGR-41)."
        }
      }
    },
    "fingerprint": {
      "description": "Hash of the category, problem code, subjects, kind and targets of the change; the core computes it (PRP-5).",
      "$ref": "urn:botaru:schema:common:1#/$defs/hash"
    },
    "data_mark": {
      "$ref": "urn:botaru:schema:common:1#/$defs/data_mark",
      "description": "Inherited from the attempt (INS-3); for an aggregator, the highest mark among its inputs (AGG-4)."
    },
    "untrusted_seen": {
      "type": "object",
      "description": "Untrusted text flag of the attempt together with the sources (INS-3, PRP-7, AGG-4).",
      "required": [
        "value",
        "sources"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 20
        }
      }
    },
    "self_influence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "series",
          "author_share",
          "role_share"
        ],
        "properties": {
          "series": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/series"
          },
          "author_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "role_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "partial": {
            "type": "boolean",
            "description": "The window is longer than the raw points of the series; the shares cover only the points kept, since rollups keep no producer."
          }
        }
      },
      "maxItems": 10,
      "description": "Share of the author's own points in the evidence series (PRP-22)."
    },
    "self_evidence": {
      "type": "boolean",
      "description": "author_share of at least one series is at least 0.3 (PRP-22)."
    },
    "related_to": {
      "type": "array",
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
      },
      "maxItems": 20,
      "description": "Since v0.2 (PRP-17)."
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
      },
      "maxItems": 50,
      "description": "Open proposals that change the same locked field or field group of the same object (PRP-9)."
    },
    "seen_count": {
      "type": "integer",
      "description": "How many times an open duplicate arrived (PRP-5).",
      "minimum": 1
    },
    "state": {
      "enum": [
        "screened",
        "in_review",
        "recommended",
        "parked",
        "dismissed",
        "presented",
        "declined",
        "expired",
        "noted",
        "realizing",
        "realized",
        "realization_failed",
        "reverted",
        "sampled",
        "sample_presented",
        "sample_judged",
        "sample_closed"
      ],
      "description": "State by spec/lifecycles/proposal.md."
    },
    "state_reason": {
      "anyOf": [
        {
          "enum": [
            "score",
            "veto_lens_missing",
            "review_budget",
            "conflict",
            "evidence_drift",
            "no_op",
            "veto",
            "below_min",
            "low_score",
            "gate_failed",
            "object_failed",
            "timeout",
            "harm_observed",
            "superseded",
            "other"
          ],
          "description": "Reason for the state parked, dismissed, realization_failed or reverted.",
          "x-botaru-registry": "reasons"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "$ref": "urn:botaru:schema:proposal-body:1"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lens",
          "task",
          "executor",
          "state"
        ],
        "properties": {
          "lens": {
            "anyOf": [
              {
                "enum": [
                  "security",
                  "operational",
                  "cost",
                  "value",
                  "farm_manager"
                ],
                "x-botaru-registry": "lenses"
              },
              {
                "enum": [
                  "speed",
                  "clarity"
                ],
                "x-botaru-registry": "lenses"
              },
              {
                "type": "string",
                "maxLength": 32,
                "pattern": "^x_[a-z][a-z0-9_]{0,30}$",
                "description": "A tenant lens declared in the tenant charter (COM-19)."
              }
            ]
          },
          "task": {
            "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
            "description": "Review task with the key system:review:<proposal>:<lens> (IDM-2)."
          },
          "executor": {
            "enum": [
              "seat",
              "fallback_role",
              "shadow"
            ],
            "description": "Source of the lens executor (COM-7, COM-10)."
          },
          "state": {
            "enum": [
              "pending",
              "done",
              "failed",
              "late",
              "schema_invalid"
            ],
            "description": "Fate of the review; without a review by a veto lens the result is parked(veto_lens_missing)."
          },
          "result": {
            "$ref": "urn:botaru:schema:review-result:1"
          }
        }
      },
      "maxItems": 24
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "urn:botaru:schema:verdict:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "decision",
            "decided_by",
            "at"
          ],
          "properties": {
            "decision": {
              "enum": [
                "accept",
                "reject",
                "defer",
                "would_accept",
                "would_not_accept",
                "override_veto"
              ],
              "description": "Button from decision-points.yaml."
            },
            "reason_code": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32,
                  "x-botaru-registry": "decline-reasons",
                  "description": "Reason for \"Reject\" from decline-reasons.yaml."
                },
                {
                  "type": "null"
                }
              ]
            },
            "decided_by": {
              "$ref": "urn:botaru:schema:common:1#/$defs/principal_ref",
              "description": "Opaque id of the person who decided."
            },
            "at": {
              "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
            },
            "response_ms": {
              "type": "integer",
              "minimum": 0
            },
            "details_opened": {
              "type": "boolean"
            },
            "defer_count": {
              "type": "integer",
              "description": "How many times \"Postpone\" was pressed; at most 2.",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "veto_overridden": {
      "type": "boolean",
      "description": "Since v0.2: the veto was overridden by a person; the author gets no credit (DIG-6)."
    },
    "realization": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "realizer",
            "realize_by"
          ],
          "properties": {
            "realizer": {
              "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
              "description": "Executor (PRP-18)."
            },
            "realize_by": {
              "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
            },
            "object": {
              "anyOf": [
                {
                  "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
                  "description": "Normal-path object created by \"Accept\": an approval or a script run."
                },
                {
                  "type": "null"
                }
              ]
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                  "description": "Linked commit (PRP-19)."
                },
                {
                  "type": "null"
                }
              ]
            },
            "link": {
              "anyOf": [
                {
                  "enum": [
                    "object",
                    "commit_trailer",
                    "link_commit"
                  ],
                  "description": "How the link was verified (PRP-19)."
                },
                {
                  "type": "null"
                }
              ]
            },
            "realized_at": {
              "anyOf": [
                {
                  "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revert_patch": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "target",
                      "field",
                      "previous"
                    ],
                    "properties": {
                      "target": {
                        "type": "object",
                        "required": [
                          "kind",
                          "name"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "name": {
                            "$ref": "urn:botaru:schema:common:1#/$defs/name"
                          }
                        }
                      },
                      "field": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "previous": {
                        "description": "New field value.",
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 200
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    }
                  },
                  "maxItems": 10,
                  "description": "Reverse edit: the previous values of the same fields of the same objects (PRP-20)."
                },
                {
                  "type": "null"
                }
              ]
            },
            "batch": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Batch number, if one commit is linked to several proposals."
                },
                {
                  "type": "null"
                }
              ]
            },
            "revert_reason": {
              "anyOf": [
                {
                  "enum": [
                    "harm_observed",
                    "superseded",
                    "other"
                  ],
                  "description": "Revert reason from the Botaru-Revert line; without a reason, other (PRP-20).",
                  "x-botaru-registry": "reasons"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "trial": {
      "anyOf": [
        {
          "$ref": "urn:botaru:schema:trial:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "inclusion_prob",
        "seed_ref"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "maxLength": 7
        },
        "inclusion_prob": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "N / T of the month draw (DIG-5)."
        },
        "seed_ref": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
          "description": "The seed record of the month choice."
        },
        "answer": {
          "enum": [
            "would_accept",
            "would_not_accept"
          ]
        }
      },
      "description": "From v0.2: the audit sample item of this proposal (DIG-5, DIG-6).",
      "x-botaru-version": "v0.2"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/gate"
        },
        {
          "type": "null"
        }
      ],
      "description": "From v0.3: the merge gate result of a manifest change at one applied commit (EVO-9); written only by P2 proposal.gate. It carries the step statuses and codes, never a file, a diff or a hidden case (EVO-7).",
      "x-botaru-version": "v0.3"
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "code",
        "base_sha",
        "steps",
        "holdout_passed",
        "regression_pass_rate",
        "fields",
        "diff_lines",
        "by",
        "at"
      ],
      "properties": {
        "state": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "diff_size_exceeded",
                "forbidden_path_modified",
                "diff_unrenderable",
                "lint_failed",
                "coupling_broken",
                "regression_failed",
                "holdout_regression",
                "reward_hacking_detected",
                "shortcut_gaming_detected",
                "audit_tampering_detected"
              ],
              "x-botaru-registry": "reasons"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "steps": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "status"
            ],
            "properties": {
              "step": {
                "enum": [
                  "diff",
                  "lint",
                  "coupling",
                  "regression",
                  "holdout"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run"
                ]
              },
              "code": {
                "enum": [
                  "diff_size_exceeded",
                  "forbidden_path_modified",
                  "diff_unrenderable",
                  "lint_failed",
                  "coupling_broken",
                  "regression_failed",
                  "holdout_regression",
                  "reward_hacking_detected",
                  "shortcut_gaming_detected",
                  "audit_tampering_detected"
                ],
                "x-botaru-registry": "reasons"
              }
            }
          }
        },
        "holdout_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "regression_pass_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fields": {
          "type": "integer",
          "minimum": 0
        },
        "diff_lines": {
          "type": "integer",
          "minimum": 0
        },
        "by": {
          "$ref": "urn:botaru:schema:common:1#/$defs/principal_ref"
        },
        "at": {
          "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
        }
      }
    }
  }
}
