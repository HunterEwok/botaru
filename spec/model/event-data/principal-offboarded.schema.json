{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:principal-offboarded:1",
  "title": "Data of the event principal.offboarded",
  "description": "A principal left for good (LCY-3); only the opaque principal id, no name.",
  "x-botaru-direction": "output",
  "x-botaru-version": "v0.2",
  "x-botaru-rules": [
    "LCY-3"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject"
  ],
  "properties": {
    "subject": {
      "$ref": "urn:botaru:schema:common:1#/$defs/principal_ref"
    },
    "erasure": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Id of the erasure request (tenant, subject)."
    }
  }
}
