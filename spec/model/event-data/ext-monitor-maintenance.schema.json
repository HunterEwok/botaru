{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:ext-monitor-maintenance:1",
  "title": "Data of the event ext.monitor.maintenance.v1",
  "description": "Maintenance window of a catalog node; on it the core sets a stop of the scope host or resource with the reason maintenance until the end of the window (MON-9).",
  "x-botaru-direction": "input",
  "x-botaru-version": "v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maintenanceid",
    "resource",
    "state"
  ],
  "properties": {
    "maintenanceid": {
      "description": "Window id in the monitoring system.",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{1,20}$"
    },
    "resource": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name",
      "description": "Catalog resource."
    },
    "state": {
      "description": "Window state.",
      "enum": [
        "active",
        "ended"
      ]
    },
    "until": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
      "description": "End of the window."
    }
  },
  "x-botaru-rules": [
    "MON-9",
    "HLD-2"
  ]
}
