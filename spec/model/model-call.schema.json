{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:model-call:1",
  "title": "Model call",
  "description": "P4 record of one model call: slot, actual profile, worst-case reserve, charge and outcome. No prompts or answers, only numbers and metadata (OBS-1). A call without an answer charges the whole reserve (BUD-11); a provider client retry only if the request was not sent, that is the call has no provider request_id (GW-12).",
  "x-botaru-direction": "record",
  "x-botaru-retention": "metadata",
  "x-botaru-rules": [
    "GW-2",
    "GW-7",
    "GW-12",
    "BUD-11"
  ],
  "type": "object",
  "required": [
    "id",
    "tenant",
    "slot",
    "profile",
    "reserve_eur_micros",
    "answered"
  ],
  "properties": {
    "id": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Call id."
    },
    "tenant": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name",
      "description": "Tenant: its key and workspace (GW-3)."
    },
    "task": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Task."
    },
    "run": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Runtime run."
    },
    "slot": {
      "description": "Model slot that the core determined.",
      "enum": [
        "base",
        "analysis",
        "seat",
        "granted"
      ]
    },
    "profile": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name",
      "description": "Actual profile."
    },
    "fallback": {
      "description": "Fallback model.",
      "type": "boolean"
    },
    "reserve_eur_micros": {
      "$ref": "urn:botaru:schema:common:1#/$defs/eur_micros",
      "description": "Worst-case reserve in micro-euros; released on the answer (BUD-9, GW-2)."
    },
    "spend_eur_micros": {
      "$ref": "urn:botaru:schema:common:1#/$defs/eur_micros",
      "description": "Charged: the usage of the call in micro-euros without rounding (BUD-9, D-87 (1))."
    },
    "request_sent": {
      "description": "The request was sent to the provider (there is a provider request_id).",
      "type": "boolean"
    },
    "answered": {
      "description": "The model answered.",
      "type": "boolean"
    },
    "reason": {
      "$ref": "urn:botaru:schema:common:1#/$defs/reason",
      "description": "Failure reason from reasons.yaml."
    },
    "started_at": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
      "description": "Start."
    },
    "finished_at": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
      "description": "End."
    }
  }
}
