{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:closed-schema:1",
  "title": "Closed schema of tool parameters",
  "description": "Meta-schema for the parameter schemas of tools and actions on a production machine (INJ-1): every parameter has an enum, enum_from, const, a number with bounds, a boolean, a string with an x-botaru-format from formats.yaml, or an object with additionalProperties false; an array only with items and maxItems. pattern, format and patternProperties are forbidden: there is no free input on a production machine with any pattern. A string without a format is allowed only for tools with placement sandbox, which this meta-schema does not check. The root is the parameter schema itself or a map name -> schema (params of a manifest).",
  "x-botaru-direction": "input",
  "x-botaru-rules": [
    "INJ-1"
  ],
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/enum_leaf"
        },
        {
          "$ref": "#/$defs/enum_from_leaf"
        },
        {
          "$ref": "#/$defs/const_leaf"
        },
        {
          "$ref": "#/$defs/number_leaf"
        },
        {
          "$ref": "#/$defs/boolean_leaf"
        },
        {
          "$ref": "#/$defs/format_leaf"
        },
        {
          "$ref": "#/$defs/object_node"
        },
        {
          "$ref": "#/$defs/array_node"
        },
        {
          "$ref": "#/$defs/ref_node"
        }
      ]
    },
    "enum_leaf": {
      "description": "A parameter from a closed list.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enum"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number"
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": [
              "string",
              "integer",
              "number"
            ],
            "maxLength": 200
          }
        },
        "default": {
          "x-botaru-closed-by": "type of the leaf"
        }
      }
    },
    "enum_from_leaf": {
      "description": "A parameter whose enum the core rebuilds from the tenant catalog.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enum_from"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "const": "string"
        },
        "enum_from": {
          "description": "Source of the enum: the tenant catalog, for example catalog.hosts, or task.attachments.",
          "$ref": "urn:botaru:schema:common:1#/$defs/dotted_name"
        },
        "default": {
          "x-botaru-closed-by": "type of the leaf"
        }
      }
    },
    "const_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "const"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "const": {
          "x-botaru-closed-by": "type of the leaf"
        }
      }
    },
    "number_leaf": {
      "description": "A number only with both bounds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum",
        "maximum"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "enum": [
            "integer",
            "number"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "default": {
          "type": "number"
        }
      }
    },
    "boolean_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "const": "boolean"
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "format_leaf": {
      "description": "A string only with a format from formats.yaml (key x-botaru-format).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "x-botaru-format"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "const": "string"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "default": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "patternProperties": {
        "^x-botaru-format$": {
          "enum": [
            "datetime",
            "duration",
            "id",
            "year_month",
            "schedule_slot",
            "tz",
            "type_name",
            "search_query"
          ]
        }
      }
    },
    "object_node": {
      "description": "An object only closed: the keys properties and additionalProperties with the value false.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "additionalProperties",
        "properties"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "const": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 64
        }
      },
      "patternProperties": {
        "^additionalProperties$": {
          "const": false
        },
        "^properties$": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "array_node": {
      "description": "An array only with closed items and a length limit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items",
        "maxItems"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "const": "array"
        },
        "items": {
          "$ref": "#/$defs/node"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        }
      }
    },
    "ref_node": {
      "description": "A reference only to a common brick of the farm schemas.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$ref"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 120
        }
      },
      "patternProperties": {
        "^\\$ref$": {
          "type": "string",
          "pattern": "^urn:botaru:schema:[a-z0-9-]+:[0-9]+#/\\$defs/[a-z_]+$",
          "maxLength": 200
        }
      }
    },
    "params_map": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/node"
    },
    {
      "$ref": "#/$defs/params_map"
    }
  ]
}
