{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:review-input:1",
  "title": "Reviewer input",
  "description": "A marked data block that the core builds for a review task (COM-3, INJ-4): closed proposal fields, evidence values re-read by the core, a description of the change in code words, the author level and the marks self_evidence, related_to and conflicts. It has no author note, no identity, role or position of the author, and no scores of other lenses (COM-2); the shape is closed so that the lint sees an extra field.",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "COM-3",
    "COM-2",
    "PRP-9",
    "PRP-15"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal",
    "lens",
    "data_mark",
    "category",
    "problem",
    "evidence",
    "change_kind",
    "change_text",
    "author_level",
    "untrusted_seen",
    "self_evidence"
  ],
  "properties": {
    "proposal": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
    },
    "lens": {
      "enum": [
        "security",
        "operational",
        "cost",
        "value",
        "farm_manager"
      ],
      "x-botaru-registry": "lenses",
      "description": "Lens of this task."
    },
    "data_mark": {
      "$ref": "urn:botaru:schema:common:1#/$defs/data_mark"
    },
    "category": {
      "$ref": "urn:botaru:schema:proposal-body:1#/$defs/category"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "subjects",
        "severity"
      ],
      "properties": {
        "code": {
          "$ref": "urn:botaru:schema:proposal-body:1#/$defs/problem_code"
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/subject"
          },
          "maxItems": 10
        },
        "severity": {
          "$ref": "urn:botaru:schema:proposal-body:1#/$defs/severity"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "series",
          "subject",
          "window",
          "rollup",
          "value"
        ],
        "properties": {
          "series": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/series"
          },
          "subject": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/subject"
          },
          "window": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/window"
          },
          "rollup": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/rollup"
          },
          "value": {
            "$ref": "urn:botaru:schema:observation-query:1#/$defs/value",
            "description": "Value re-read by the core (PRP-2)."
          }
        }
      },
      "maxItems": 10
    },
    "change_kind": {
      "$ref": "urn:botaru:schema:proposal-body:1#/$defs/change_kind"
    },
    "change_text": {
      "type": "string",
      "maxLength": 2000,
      "description": "The change in code words by a template, with the rate before and after and the affected alarms."
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "promised"
      ],
      "properties": {
        "metric": {
          "$ref": "urn:botaru:schema:observation-query:1#/$defs/series"
        },
        "subject": {
          "$ref": "urn:botaru:schema:observation-query:1#/$defs/subject"
        },
        "promised": {
          "$ref": "urn:botaru:schema:proposal-body:1#/$defs/promised"
        }
      }
    },
    "cost_eur": {
      "type": "object",
      "description": "Price that code computes.",
      "additionalProperties": false,
      "properties": {
        "one_time_eur": {
          "type": "number",
          "minimum": 0
        },
        "monthly_eur": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "author_level": {
      "enum": [
        0,
        1
      ],
      "description": "Author level: 0 a seat bot, 1 an aggregator."
    },
    "untrusted_seen": {
      "type": "boolean",
      "description": "Whether the author attempt saw untrusted text (PRP-7)."
    },
    "self_evidence": {
      "type": "boolean",
      "description": "Mark of the author's own share in the evidence when author_share is at least 0.3, without the author identity (PRP-15)."
    },
    "related_to": {
      "type": "array",
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
      },
      "maxItems": 20,
      "description": "Related proposals (PRP-17, since v0.2)."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal",
          "state"
        ],
        "properties": {
          "proposal": {
            "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
          },
          "state": {
            "enum": [
              "screened",
              "in_review",
              "recommended",
              "parked",
              "dismissed",
              "presented",
              "declined",
              "expired",
              "noted",
              "realizing",
              "realized",
              "realization_failed",
              "reverted",
              "sampled",
              "sample_presented",
              "sample_judged",
              "sample_closed"
            ]
          },
          "trial_outcome": {
            "anyOf": [
              {
                "enum": [
                  "better",
                  "unchanged",
                  "worse",
                  "undetermined",
                  "mixed",
                  "canceled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "realized_at": {
            "anyOf": [
              {
                "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 50,
      "description": "Code table: changes of the same subjects over 30 days with trial results, and open proposals about them (PRP-9)."
    }
  }
}
