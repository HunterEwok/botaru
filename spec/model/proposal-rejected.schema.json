{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:proposal-rejected:1",
  "title": "Data of the event proposal.rejected.v1",
  "description": "A refusal when creating a proposal creates no record: the core writes the event proposal.rejected.v1 with a reason from a closed list, like a task enqueue refusal. The author sees their refusals in \"My results\" (DIG-7).",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "MGR-47",
    "PRP-1",
    "PRP-2",
    "PRP-3",
    "PRP-5",
    "PRP-11",
    "PRP-21",
    "PRP-24"
  ],
  "type": "object",
  "required": [
    "reason",
    "task",
    "role"
  ],
  "properties": {
    "reason": {
      "enum": [
        "schema_invalid",
        "evidence_mismatch",
        "forbidden_change",
        "untrusted_direction",
        "metric_unknown",
        "recently_declined",
        "proposal_rate_limited",
        "resubmit_too_early",
        "manager_restricted"
      ],
      "description": "Refusal reason; from v0.3 also resubmit_too_early (PRP-24) and manager_restricted for a proposal of the farm manager seat in restricted mode (MGR-47).",
      "x-botaru-registry": "reasons"
    },
    "task": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "The analysis or aggregator task whose attempt handed in the body."
    },
    "role": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name"
    },
    "worker": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "The worker of the attempt that handed in the body; \"My results\" shows the refusal to it alone (DIG-7)."
    },
    "acting_bot": {
      "anyOf": [
        {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "anyOf": [
        {
          "$ref": "urn:botaru:schema:proposal-body:1#/$defs/category"
        },
        {
          "type": "null"
        }
      ]
    },
    "problem_code": {
      "anyOf": [
        {
          "$ref": "urn:botaru:schema:proposal-body:1#/$defs/problem_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprint": {
      "anyOf": [
        {
          "$ref": "urn:botaru:schema:common:1#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
