{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:ballot:1",
  "title": "Ballot",
  "description": "Ballot record of the \"who leaves\" vote (GOV-7, GOV-23). The core takes the choice value from the P4 answer with the forced schema of this attempt, not from the complete body; the core writes forced without a model call if the choice list has one seat; the core writes defaulted by the code rule when the model refuses. In a round there is exactly one ballot per voter; until the round closes no bot sees the ballots. Reason codes come from a closed list that the skeleton text does not name yet.",
  "x-botaru-direction": "record",
  "x-botaru-retention": "metadata",
  "x-botaru-version": "v0.2",
  "x-botaru-rules": [
    "GOV-7",
    "GOV-21",
    "GOV-23",
    "IDN-12"
  ],
  "type": "object",
  "required": [
    "case",
    "round",
    "voter",
    "choice",
    "forced",
    "defaulted"
  ],
  "properties": {
    "case": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Case."
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "description": "Round."
    },
    "voter": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Voting identity (acting_bot)."
    },
    "choice": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^(farm-manager|commission:[1-9][0-9]{0,2})$",
      "description": "Seat id: farm-manager (the farm manager seat, tenant farm) or commission:<seat number from the tenant charter>."
    },
    "reasons": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "Up to 3 reason codes."
    },
    "forced": {
      "type": "boolean",
      "description": "Forced ballot."
    },
    "defaulted": {
      "type": "boolean",
      "description": "Ballot by the code rule."
    },
    "worker": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "The worker that executed it (IDN-12)."
    },
    "reissue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Reissue number, at most ballots.reissue_max."
    },
    "recorded_at": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
      "description": "Record time."
    }
  }
}
