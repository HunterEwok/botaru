{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p2-list-response:1",
  "title": "P2: object list",
  "description": "Answer of list operations without their own row form: campaign.list, script.list, incident.list, bot.list, control.list. A row carries the id, state and time; the show operation gives details.",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "PRM-9"
  ],
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
          },
          "state": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "created_at": {
            "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "maxItems": 1000
    },
    "next": {
      "type": "string",
      "maxLength": 200,
      "description": "Cursor of the next page from the previous answer."
    }
  }
}
