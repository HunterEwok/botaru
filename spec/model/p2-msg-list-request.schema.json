{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p2-msg-list-request:1",
  "title": "P2 msg.list: request",
  "description": "Filters of the message list, only closed values: type, sender or recipient role, state and a time window (MSG-18). The operator may name a tenant; a person with admin:people sees only their own tenant.",
  "x-botaru-direction": "input",
  "x-botaru-version": "v0.2",
  "x-botaru-rules": [
    "MSG-18",
    "MSG-3"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op"
  ],
  "properties": {
    "op": {
      "const": "msg.list"
    },
    "tenant": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name"
    },
    "type": {
      "$ref": "urn:botaru:schema:common:1#/$defs/type_name"
    },
    "role": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name"
    },
    "state": {
      "enum": [
        "staged",
        "queued",
        "leased",
        "acked",
        "discarded",
        "dead",
        "expired",
        "current",
        "stale",
        "replaced",
        "removed"
      ]
    },
    "since": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
    },
    "until": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "after": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_:.-]+$",
      "description": "Page cursor: the last message id of the previous page."
    }
  }
}
