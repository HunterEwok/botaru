{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p3-server-discover-response:1",
  "title": "P3 server/discover: response",
  "description": "Capabilities of the P3 server and the version of the tool protocol profile (spec/bindings/mcp/README.md): only tools, profile botaru-tool-gateway/1.",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "SEC-3"
  ],
  "type": "object",
  "required": [
    "capabilities",
    "profile"
  ],
  "properties": {
    "capabilities": {
      "type": "object",
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "type": "object"
        }
      }
    },
    "profile": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^botaru-tool-gateway/[1-9][0-9]*$"
    },
    "protocolVersion": {
      "type": "string",
      "maxLength": 32
    }
  }
}
