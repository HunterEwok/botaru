{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:run-request:1",
  "title": "RunRequest of port E4",
  "description": "Input of the E4 run operation: after P1 claim, the E4 adapter gives the runtime only the task body, the trusted instruction, handles and limits. The runtime has neither the worker token nor the provider key (DEP-5). run_id of the form <task id>:<lease_no> is the idempotency key: one runtime run per attempt lease (FEN-1). The answer limits of a single call are set by P4 from the model profile, not by the runtime.",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "FEN-1",
    "FEN-4",
    "SEC-3"
  ],
  "type": "object",
  "required": [
    "run_id",
    "instruction",
    "body",
    "tools",
    "model",
    "limits"
  ],
  "properties": {
    "run_id": {
      "$ref": "urn:botaru:schema:common:1#/$defs/attempt_ref"
    },
    "instruction": {
      "description": "Text of the role and task type from git; trusted.",
      "type": "string"
    },
    "body": {
      "$ref": "urn:botaru:schema:task-body:1"
    },
    "tools": {
      "description": "Access to tools only through P3.",
      "type": "object",
      "required": [
        "mcp_endpoint",
        "handle"
      ],
      "properties": {
        "mcp_endpoint": {
          "type": "string",
          "maxLength": 500
        },
        "handle": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "model": {
      "description": "Access to the model only through P4.",
      "type": "object",
      "required": [
        "endpoint",
        "handle"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 500
        },
        "handle": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "session": {
      "description": "Session handle or null.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "memory": {
      "description": "Memory handle or null.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "skills": {
      "description": "References to skills from the repository by $defs/skill_ref.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_ref"
      },
      "maxItems": 20
    },
    "limits": {
      "type": "object",
      "required": [
        "max_turns",
        "run_max_input_tokens",
        "deadline"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "run_max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
        }
      }
    },
    "reply_locale": {
      "x-botaru-version": "v0.2",
      "description": "Language of the model answer; the model does not guess it (DLV-9).",
      "type": "string",
      "maxLength": 35
    }
  },
  "$defs": {
    "skill_ref": {
      "description": "Reference to a role skill: name, description and hash of the skill directory tree (SKL-2, docs/capabilities.md).",
      "type": "object",
      "required": [
        "name",
        "description",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "urn:botaru:schema:common:1#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        }
      }
    }
  }
}
