{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p2-connection-register-request:1",
  "title": "P2 connection.register: request",
  "description": "The consent adapter registers a connection after the person granted access at the provider (SEC-7). The adapter acts on behalf of the person (Botaru-On-Behalf); the core takes the principal from it, not from the body. The token stays in the deployment secret store; the body carries only its reference.",
  "x-botaru-direction": "input",
  "x-botaru-version": "v0.2",
  "x-botaru-rules": [
    "SEC-7"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant",
    "provider",
    "scopes",
    "token_ref",
    "expires_at"
  ],
  "properties": {
    "tenant": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name"
    },
    "provider": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mail_read",
          "mail_send",
          "calendar_read",
          "calendar_write",
          "files_read",
          "files_write"
        ],
        "x-botaru-registry": "connection-scopes"
      }
    },
    "token_ref": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_./-]+$"
    },
    "expires_at": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
    }
  }
}
