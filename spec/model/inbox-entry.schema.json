{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:inbox-entry:1",
  "title": "Inbox entry",
  "description": "Inbox entry in the C1 store: one message in one inbox of one tenant; a copy of an all delivery is a separate entry (MSG-14). Only in the store, not in the envelope: the number in the inbox, state, size, hash, number of dispatches and recipients, the sender's bot identity. Only the core changes the state, following the lifecycle spec/lifecycles/message.md.",
  "x-botaru-direction": "record",
  "x-botaru-retention": "metadata",
  "x-botaru-rules": [
    "MSG-9",
    "MSG-15",
    "MSG-12",
    "MSG-14",
    "MSG-15"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "tenant",
    "inbox",
    "seq",
    "kind",
    "type",
    "state",
    "size_bytes",
    "hash",
    "expires_at"
  ],
  "properties": {
    "message": {
      "type": "string",
      "pattern": "^m_[0-9A-HJKMNP-TV-Z]{26}$",
      "maxLength": 28,
      "description": "Message id."
    },
    "tenant": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name"
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "role",
            "group",
            "worker"
          ],
          "description": "Inbox key: (tenant, role), (tenant, bot group) or (tenant, worker)."
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "maxLength": 63,
          "description": "Name of a role or bot group, or a worker id."
        }
      }
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Number in the inbox; order is promised only within one inbox (MSG-14)."
    },
    "kind": {
      "enum": [
        "report",
        "state"
      ],
      "x-botaru-registry": "message-kinds"
    },
    "type": {
      "$ref": "urn:botaru:schema:common:1#/$defs/type_name"
    },
    "from_role": {
      "$ref": "urn:botaru:schema:common:1#/$defs/name"
    },
    "sender_bot": {
      "type": "string",
      "pattern": "^bot_[0-9A-HJKMNP-TV-Z]{26}$",
      "maxLength": 30,
      "description": "The sender's bot identity, if there is one."
    },
    "state": {
      "enum": [
        "staged",
        "queued",
        "leased",
        "acked",
        "discarded",
        "dead",
        "expired",
        "current",
        "stale",
        "replaced",
        "removed"
      ],
      "description": "State by the lifecycle spec/lifecycles/message.md."
    },
    "reason": {
      "$ref": "urn:botaru:schema:common:1#/$defs/reason",
      "description": "Reason for the final state: held, recipient_gone, delivery_exhausted."
    },
    "deliveries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Number of counted dispatches; the third makes the entry dead (MSG-9)."
    },
    "leased_by": {
      "type": "string",
      "pattern": "^[a-z]{1,8}_[0-9A-HJKMNP-TV-Z]{26}$",
      "maxLength": 40,
      "description": "The attempt that holds the entry."
    },
    "recipients": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50,
      "description": "Number of recipients of an all delivery."
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192,
      "description": "Envelope size, at most 8 KiB (MSG-15)."
    },
    "hash": {
      "$ref": "urn:botaru:schema:common:1#/$defs/hash"
    },
    "expires_at": {
      "$ref": "urn:botaru:schema:common:1#/$defs/datetime"
    }
  }
}
