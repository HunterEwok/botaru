{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:governance-case:1",
  "title": "Governance case",
  "description": "Governance case (GovernanceCase): one promotion of a functionary to the commission of its tenant together with the \"who leaves\" vote, if there is no vacant seat. Only the core writes it; only the governance loop opens it for the head of the queue, there is no P2 open operation (GOV-6). The snapshot of the voters V, the list L and the seed does not change after opening (GOV-12). A case has no free text, and no bot sees it (GOV-29). Flags only from spec/model/governance-flags.yaml (GOV-19).",
  "x-botaru-direction": "record",
  "x-botaru-retention": "metadata",
  "x-botaru-version": "v0.2",
  "x-botaru-rules": [
    "GOV-6",
    "GOV-8",
    "GOV-12",
    "GOV-16",
    "GOV-19",
    "GOV-23",
    "GOV-29"
  ],
  "type": "object",
  "required": [
    "id",
    "tenant",
    "kind",
    "state",
    "subject"
  ],
  "properties": {
    "id": {
      "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
      "description": "Case id."
    },
    "tenant": {
      "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name",
      "description": "Tenant of the commission; the case lives only in it (GOV-16)."
    },
    "kind": {
      "const": "promotion",
      "description": "There is one case kind."
    },
    "state": {
      "enum": [
        "opened",
        "parked",
        "balloting",
        "counted",
        "confirming",
        "effective",
        "rejected",
        "expired",
        "canceled"
      ],
      "description": "State of the case lifecycle (spec/lifecycles/case.md)."
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "description": "Round number for balloting(n) and counted(n)."
    },
    "hold": {
      "type": "boolean",
      "description": "Pause by people: a stop of the governance scope."
    },
    "stuck": {
      "description": "The stuck flag: the round waits for votes longer than stuck_after.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "since"
          ],
          "properties": {
            "since": {
              "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
              "description": "Since when."
            },
            "missing": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "voter",
                  "reason"
                ],
                "properties": {
                  "voter": {
                    "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
                    "description": "Voter."
                  },
                  "reason": {
                    "$ref": "urn:botaru:schema:common:1#/$defs/reason",
                    "description": "Infrastructure reason."
                  }
                }
              },
              "description": "Missing votes."
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger": {
      "type": "object",
      "required": [
        "proposal"
      ],
      "properties": {
        "proposal": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
          "description": "The proposal that is the trigger."
        },
        "realized_at": {
          "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
          "description": "Executed."
        },
        "probation_until": {
          "$ref": "urn:botaru:schema:common:1#/$defs/datetime",
          "description": "End of the promotion probation."
        }
      },
      "description": "Trigger (GOV-14)."
    },
    "subject": {
      "type": "object",
      "required": [
        "candidate",
        "mode"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:botaru:schema:common:1#/$defs/object_id",
          "description": "Candidate."
        },
        "mode": {
          "enum": [
            "removal",
            "vacancy"
          ],
          "description": "removal: someone leaves; vacancy: a vacant seat without a vote."
        }
      },
      "description": "Candidate and mode."
    },
    "snapshot": {
      "type": "object",
      "required": [
        "voters",
        "list",
        "seed"
      ],
      "properties": {
        "voters": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
          },
          "description": "Voters V."
        },
        "list": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 16,
            "pattern": "^(farm-manager|commission:[1-9][0-9]{0,2})$",
            "description": "Seat id: farm-manager (the farm manager seat, tenant farm) or commission:<seat number from the tenant charter>."
          },
          "description": "Seats L; the farm manager seat is never in L."
        },
        "seed": {
          "type": "string",
          "maxLength": 200,
          "description": "Order seed."
        }
      },
      "description": "Unchangeable snapshot at opening (GOV-12)."
    },
    "expected": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/object_id"
      },
      "description": "The expected set; it shrinks only by a person's action or a core loop with the flag voters_removed (GOV-23)."
    },
    "rounds": {
      "type": "array",
      "maxItems": 1000,
      "description": "Counting rounds (GOV-8).",
      "items": {
        "type": "object",
        "required": [
          "n",
          "list",
          "need"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "description": "Round number."
          },
          "list": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "maxLength": 16,
              "pattern": "^(farm-manager|commission:[1-9][0-9]{0,2})$",
              "description": "Seat id: farm-manager (the farm manager seat, tenant farm) or commission:<seat number from the tenant charter>."
            },
            "description": "List of the round."
          },
          "need": {
            "type": "integer",
            "minimum": 1,
            "description": "ceil(2/3 · |expected|)."
          },
          "ballots": {
            "type": "object",
            "properties": {
              "expected": {
                "type": "integer",
                "minimum": 0,
                "description": "Expected."
              },
              "recorded": {
                "type": "integer",
                "minimum": 0,
                "description": "Recorded."
              },
              "forced": {
                "type": "integer",
                "minimum": 0,
                "description": "Forced."
              },
              "defaulted": {
                "type": "integer",
                "minimum": 0,
                "description": "By the code rule."
              },
              "reissued": {
                "type": "integer",
                "minimum": 0,
                "description": "Reissues."
              }
            },
            "description": "Ballot counters of the round."
          },
          "tally": {
            "type": "object",
            "maxProperties": 1000,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Votes by seat."
          },
          "tie_seed": {
            "type": "string",
            "maxLength": 200,
            "description": "Tie seed; the core draws it after all ballots of the round are recorded."
          },
          "result": {
            "type": "object",
            "description": "struck (a struck-out seat) or leaver (the leaving seat)."
          },
          "tie": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "enum": [
                "K1",
                "K2",
                "K3",
                "K4"
              ]
            },
            "description": "Tie keys that fired."
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "line": {
          "const": "governance",
          "description": "Budget line of the case (GOV-15)."
        },
        "reserved_eurocents": {
          "$ref": "urn:botaru:schema:common:1#/$defs/eurocents",
          "description": "Reserve of the estimate of all rounds."
        }
      },
      "description": "Reserve of the governance line."
    },
    "flags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*$",
        "x-botaru-registry": "governance-flags"
      },
      "description": "Case flags."
    },
    "outcome": {
      "description": "Outcome: {leaver: seat} or {vacancy: seat}.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "confirmation": {
      "description": "People's decision: who, when, the decision and a reason code from governance-decline-reasons.yaml; only a human principal.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    }
  }
}
