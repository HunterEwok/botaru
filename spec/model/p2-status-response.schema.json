{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botaru:schema:p2-status-response:1",
  "title": "P2 status: response",
  "description": "The applied commit and set hash, errors by object, active stops, the conforms_to claim (MAN-8) and the tenants with farm_manager.enabled: false. From conforms_to the runner learns the implementation profiles.",
  "x-botaru-direction": "output",
  "x-botaru-rules": [
    "MAN-2",
    "MAN-8",
    "HLD-1",
    "MGR-42",
    "STA-3"
  ],
  "type": "object",
  "required": [
    "commit",
    "conforms_to"
  ],
  "properties": {
    "commit": {
      "type": "string",
      "maxLength": 64
    },
    "set_hash": {
      "$ref": "urn:botaru:schema:common:1#/$defs/hash"
    },
    "errors": {
      "$ref": "urn:botaru:schema:p2-apply-response:1#/properties/errors"
    },
    "holds": {
      "type": "array",
      "items": {
        "$ref": "urn:botaru:schema:hold:1"
      },
      "maxItems": 1000
    },
    "conforms_to": {
      "type": "object",
      "required": [
        "skeleton",
        "profiles"
      ],
      "properties": {
        "skeleton": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "core",
              "messaging",
              "campaign",
              "insights",
              "manager",
              "governance",
              "monitor",
              "knowledge",
              "ingress",
              "connections",
              "debug",
              "sandbox"
            ]
          },
          "maxItems": 12,
          "uniqueItems": true
        }
      }
    },
    "farm_manager_disabled": {
      "type": "array",
      "items": {
        "$ref": "urn:botaru:schema:common:1#/$defs/tenant_name"
      },
      "maxItems": 1000
    },
    "workers": {
      "$ref": "urn:botaru:schema:status-workers-result:1#/properties/workers",
      "description": "From v0.2: workers with both columns and the mismatch code (STA-3).",
      "x-botaru-version": "v0.2"
    }
  }
}
